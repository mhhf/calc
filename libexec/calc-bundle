#!/usr/bin/env node
/**
 * Generate browser-compatible bundle
 *
 * This script pre-processes the ILL calculus spec files and generates
 * a JSON bundle that can be used in the browser without file system access.
 *
 * Precomputes all derived data from .family/.calc/.rules so that browser
 * hydration only needs to create functions (closures), not recompute tables.
 *
 * Usage: calc bundle [output-path]
 */

import fs from 'fs';
import path from 'path';
import crypto from 'crypto';
import calculus from '../lib/calculus/index.js';
import { parserTables as computeParserTables, rendererFormats as computeRendererFormats, connByType as computeConnectivesByType } from '../lib/calculus/builders.js';
import { specMeta as computeRuleSpecMeta } from '../lib/prover/rule-interpreter.js';
import { loadILL } from '../calculus/ill/index.js';
async function main() {
  const outputPath = process.argv[2] || path.join(import.meta.dirname, '../out/ill.json');

  console.log('Loading ILL calculus...');
  const ill = await loadILL();

  // Precompute derived tables (pure data, serializable)
  const parserTables = computeParserTables(ill.constructors);
  const rendererFormats = computeRendererFormats(ill.constructors);
  const ruleSpecMeta = computeRuleSpecMeta(ill.rules);
  const connectivesByType = computeConnectivesByType(ill.constructors);

  // ZK tag mapping — assigns a unique integer to each formula connective.
  // Used by the FORMULA_BUS in STARK circuits. Derived from definition order
  // in .calc (excluding 'atom' which is structural, not a connective).
  const zkTags = {};
  connectivesByType.formula
    .filter(name => name !== 'atom')
    .forEach((name, i) => { zkTags[name] = i + 1; });
  console.log(`ZK tags: ${JSON.stringify(zkTags)}`);

  // Extract the data we need for browser use
  // (everything except functions which can't be serialized)
  // Freshness stamp (audit 2026-09-02): hash of the calculus source
  // files the bundle is derived from. tests/bundle-freshness.test.js
  // recomputes it — editing any source without `npm run build:bundle`
  // fails the fast suite instead of silently serving a stale bundle.
  const ROOT = path.join(import.meta.dirname, '..');
  const sources = ['calculus/ill/ill.calc', 'calculus/ill/ill.rules', 'family/lnl/lnl.family'];
  const sh = crypto.createHash('sha256');
  for (const rel of sources) sh.update(rel).update('\0').update(fs.readFileSync(path.join(ROOT, rel)));
  const sourceHash = sh.digest('hex');

  const bundle = {
    version: '2.0',
    generated: new Date().toISOString(),
    sources,
    sourceHash,
    name: ill.name,
    baseTypes: ill.baseTypes,
    contextStructure: ill.contextStructure,
    constructors: ill.constructors,
    directives: ill.directives,
    rules: ill.rules,
    polarity: ill.polarity,
    invertible: ill.invertible,

    // Precomputed tables — skip recomputation at hydration
    parserTables,
    rendererFormats,
    ruleSpecMeta,
    connectivesByType,
    zkTags
  };

  // Ensure output directory exists
  const outDir = path.dirname(outputPath);
  if (!fs.existsSync(outDir)) {
    fs.mkdirSync(outDir, { recursive: true });
  }

  fs.writeFileSync(outputPath, JSON.stringify(bundle, null, 2));
  console.log(`Written to ${outputPath}`);

  // Also generate a TypeScript definition
  const dtsPath = outputPath.replace('.json', '.d.ts');
  const dts = `// Auto-generated type definitions for ILL bundle
export interface Constructor {
  name: string;
  argTypes: string[];
  returnType: string;
  annotations: Record<string, any>;
}

export interface Rule {
  name: string;
  descriptor: {
    connective: string | null;
    side: 'l' | 'r' | null;
    arity: number;
    copyContext: boolean;
    emptyLinear: boolean;
    contextSplit: boolean;
    contextFlow: string;
    premises: Array<{ linear?: number[]; cartesian?: number[]; succedent?: number }>;
  };
  invertible: boolean | null;
  pretty: string;
  structural: boolean;
  bridge: string | null;
  numPremises: number;
}

export interface ParserTables {
  operators: Array<{ name: string; op: string; precedence: number; assoc: string; ascii: string }>;
  nullary: Record<string, string>;
  unaryPrefix: Record<string, { name: string; precedence: number }>;
}

export interface RendererFormats {
  ascii: Record<string, { template: string; prec: number }>;
  latex: Record<string, { template: string; prec: number }>;
}

export interface RuleSpecMeta {
  specData: Record<string, { copyContext: boolean; requiresEmptyDelta?: boolean; contextSplit?: boolean }>;
  alternatives: Record<string, string[]>;
}

export interface ILLBundle {
  version: string;
  generated: string;
  name: string;
  baseTypes: Record<string, any>;
  constructors: Record<string, Constructor>;
  directives: Record<string, any>;
  rules: Record<string, Rule>;
  polarity: Record<string, 'positive' | 'negative'>;
  invertible: Record<string, boolean>;
  parserTables: ParserTables;
  rendererFormats: RendererFormats;
  ruleSpecMeta: RuleSpecMeta;
}

declare const bundle: ILLBundle;
export default bundle;
`;
  fs.writeFileSync(dtsPath, dts);
  console.log(`Written type definitions to ${dtsPath}`);
}

main().catch(err => {
  console.error('Error:', err);
  process.exit(1);
});
