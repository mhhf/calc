#import(../../calculus/till/prelude/rat.ill)

% Fire-time woplus weights (Phase 6): the combat.till duel — the branch
% weight Q is BOUND BY MATCHING (!winprob U V Q), not a compile-time
% literal. One rule, lazy-predicate kernel: !winprob IS the matrix.

utype: type.
rock: utype.
paper: utype.
sci: utype.

red: (u: utype) -> type.
blue: (u: utype) -> type.
fellr: (u: utype) -> type.
fellb: (u: utype) -> type.

% q is a WEIGHT (TODO_0011 rung 1): probability literals pass the [0,1]
% value fence, and the bound Q flows sort-checked into woplus's weight hole.
winprob: (a: utype) -> (b: utype) -> (q: weight) -> type.
winprob/rr: winprob rock rock (1/2).
winprob/rs: winprob rock sci (3/4).
winprob/sr: winprob sci rock (1/4).
winprob/one: winprob rock paper 1.
winprob/zero: winprob paper rock 0.

duel: red(U) * blue(V) * !winprob U V Q
  -o { woplus Q (red(U) * fellb(V)) (blue(V) * fellr(U)) }.
