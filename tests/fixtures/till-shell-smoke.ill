% round-15 F6.iv — till-shell --demo smoke fixture: a standing costed
% menu (loli = shop line, cut-on-click) + a free token alternative.
spc_s: type.
farm_s: type.
wood_s: type.

%#display resource: spc_s wood_s farm_s

% with the cost in stock: click 1 cuts (farm at t+3), click 2 grants wood
#expect_start (settle: 0)
  !(( !_2 spc_s -o { farm_s }@3 ) & wood_s) * !_2 spc_s
  =>
  !_2 spc_s .

% no cost: click 1 must be REFUSED (strict loli), click 2 still works
#expect_nospc (settle: 0)
  !(( !_2 spc_s -o { farm_s }@3 ) & wood_s)
  =>
  I .
