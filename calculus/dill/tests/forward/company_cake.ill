#import(../../prelude/governance.ill)

% company_cake.ill — the composite-principal scenario (TODO_0276), on the shared
% governance prelude. Alice(1)+Bob(2) hold 50/50 equity in company C(3); C holds
% 1000; a shareholder quorum authorizes spending 700 on a cake; the cake lands at
% C, not the shareholders, and the 50/50 cap table is untouched.
%
% The prelude supplies the generic machinery (cast_vote/tally/close). The scenario
% adds only: proposal opening (which shareholders get tickets), the asset vocab,
% and the enactment (what the authorization buys).

money:     (m: q) -> type.
cake:      (n: q) -> type.
buy_price: (p: q) -> (price: q) -> type.   % persistent proposal detail

% open_proposal: seed → one ticket per shareholder + session + tally scaffold.
% (Ground for a two-shareholder company; parametric issuance from a cap table is P1.)
open_proposal:
  propose_seed P TH N
  -o { vote_ticket 1 P * vote_ticket 2 P
     * vote_open P TH * tally_init_token P * vote_sentinel P N }.

% buy_cake: C-only asset transform (pre-bound R for the arithmetic, HOLE A fix).
buy_cake:
  says 3 (authorized P) * says 3 (money M)
  * !buy_price P PRICE * !le PRICE M * !qsub M PRICE R
  -o { says 3 (cake 1) * says 3 (money R) }.

% Genesis: Alice 50%, Bob 50%, C holds 1000; proposal 100 buys cake for 700.
#expect_cake (settle: 0)
  says 1 (stake 3 (1/2)) * says 2 (stake 3 (1/2)) * says 3 (money 1000)
    * propose_seed 100 (1/2) 2
    * !buy_price 100 700 * !prop_company 100 3
  =>
  says 3 (cake 1) * says 3 (money 300)
    * says 1 (stake 3 (1/2)) * says 2 (stake 3 (1/2)) .
