#import(../../../gill/prelude/num.gill)

% elect_a_rule.ill — governance over PROGRAMS, not just data (use-case 3).
%
% The collective elects an *implementation*: the winning policy is `enact`ed as a
% live loli (a possessed/installed rule, timed.js ground-loli), which then governs
% the next execution. Electing an implementation of `money -o {…}` IS what
% deciding that spending policy means (dill design: "elected code is DERIVED").
%
% Ground-loli today (variable-binding possessed rules are the [[0269]] 6b
% extension), so the enacted policy is ground — enough to show a governed program.

money:   (m: q) -> type.
cake:    (n: q) -> type.
reserve: (n: q) -> type.
elected_bold:   type.   % says 3 (elected_bold) after a quorum in the full flow
elected_frugal: type.

% enact_*: the elected token installs a spending policy as a live loli fact.
enact_bold:   elected_bold   -o { (money 700 -o { cake 1 }) }.
enact_frugal: elected_frugal -o { (money 700 -o { reserve 700 }) }.

% If the collective elected the bold policy, 700 buys a cake.
#expect_bold (settle: 0)
  elected_bold * money 700
  =>
  cake 1 .

% If it elected the frugal policy instead, the SAME money is reserved — the
% elected code, not the data, decides the outcome.
#expect_frugal (settle: 0)
  elected_frugal * money 700
  =>
  reserve 700 .

% The bold policy does NOT reserve (the two elected programs are exclusive).
#expect_not_bold_reserves (settle: 0)
  elected_bold * money 700
  =>
  reserve 700 .
