% =============================================================================
% gill sequent rules — the graded fragment (TODO_0284)
% =============================================================================
%
% The till.rules fragment carries over verbatim (see its header for the
% full design notes): gill's surface contains till's graded surface, so
% the backward judgment is shared — the multiplicative core, `with`, the
% ω and counted bang, the graded monad (bind via the ⊖ residual theory
% premise), stamped-atom retiming. Theory premises resolve over gill's
% numeric prelude (prelude/num.gill — till's tower + the collapsed
% min/max instances). gill's OWN fragment is the graded transport
% comonad (haul — P3, below the shared rules).

@formulas A, B, C

id: ; A |- A
  @pretty "Id"
  @invertible true.

tensor_r: G ; D, D' |- A * B
  <- G ; D |- A
  <- G ; D' |- B
  @pretty "⊗R".

tensor_l: G ; D, A * B |- C
  <- G ; D, A, B |- C
  @pretty "⊗L".

loli_r: G ; D |- A -o B
  <- G ; D, A |- B
  @pretty "⊸R".

loli_l: G ; D, D', A -o B |- C
  <- G ; D |- A
  <- G ; D', B |- C
  @pretty "⊸L".

with_r: G ; D |- A & B
  <- G ; D |- A
  <- G ; D |- B
  @pretty "&R".

with_l1: G ; D, A & B |- C
  <- G ; D, A |- C
  @pretty "&L₁".

with_l2: G ; D, A & B |- C
  <- G ; D, B |- C
  @pretty "&L₂".

one_r: G ; |- I
  @pretty "1R".

one_l: G ; D, I |- C
  <- G ; D |- C
  @pretty "1L".

% ── ω exponential (template-matched: `!A` = bang(ω, A) is the pattern) ──

bang_r: G ; |- !A
  <- G ; |- A
  @pretty "!R"
  @invertible false
  @template true
  @bridge linear_to_cartesian.

bang_l: G ; D, !A |- C
  <- G ; D, A |- C
  @pretty "!D"
  @invertible false
  @template true.

bang_l2: G ; D, !A |- C
  <- G, A ; D |- C
  @pretty "!L"
  @invertible false
  @template true
  @bridge linear_to_cartesian.

% ── counted exponential: !_k A as k linear parcels ──

bang_l3: G ; D, !_K A |- C
  <- G ; D, A, !_J A |- C
  <- !qsub K 1 J
  @pretty "!Lpeel"
  @invertible false.

bang_l4: G ; D, !_K A |- C
  <- G ; D |- C
  <- !eq K 0
  @pretty "!L0"
  @invertible false.

bang_r2: G ; D, D' |- !_K A
  <- G ; D |- A
  <- G ; D' |- !_J A
  <- !qsub K 1 J
  @pretty "!Rpeel"
  @invertible false.

% Empty linear context REQUIRED (like one_r): !_0 A ⊣⊢ I — see till.rules
% (affine-leak fix, THY_0027 audit).
bang_r3: G ; |- !_K A
  <- !eq K 0
  @pretty "!R0"
  @invertible false.

% ── graded lax monad: bind + unit·sub (THY_0018 §4; see till.rules) ──

monad_l: G ; D, {A}@E |- {C}@F
  <- G ; D, A |- {C}@H
  <- !qsub F E H
  @side l
  @pretty "{}L"
  @invertible false.

monad_r: G ; D |- {A}@E
  <- G ; D |- A
  <- !le 0 E
  @pretty "{}R"
  @invertible false.

monad_r2: G ; D |- {A}@E
  @pretty "{}settle"
  @invertible false
  @modeShift true.

% ── graded transport comonad (TODO_0284 P3): the spatial dual ──
% !!_d A = "A reachable within haul-cost d" — the upper-bound reading,
% mirroring the monad ({A}@d = achievable within duration d). Exact
% accounting through the SAME ⊖ residual theory premise as monad_l:
% grades are ℚ≥0 and qsub is checked, so no rule can construct a negative
% cost (Grade Preservation, THY_0022) and !!_5 a |- !!_3 a stays refuted
% with no side condition. Derivable (deliberately not primitive):
%   subsumption  !!_E A |- !!_F A, F ≥ E      (haul_l + haul_r)
%   graded-μ     !!_E (!!_F A) |- !!_G A, G ≥ E+F   (haul_l twice + haul_r)
% Cross-modality rules (haul against a monad conclusion — "transport
% takes time") are DELIBERATELY absent: the additive coupling violates
% the matched-pair axioms (R2b); that interaction is a rule in 0285.

% Fetch (the bind dual): with A in hand, C is reachable within H ⟹ with
% A at cost E, C is reachable within F = E + H (go get A, then proceed).
haul_l: G ; D, !!_E A |- !!_F C
  <- G ; D, A |- !!_H C
  <- !qsub F E H
  @side l
  @pretty "!!L"
  @invertible false.

% Cost-0 dereliction: reachable at cost 0 = possessed. (Named by the
% alternatives convention — conn_l, conn_l2, … group as one left menu.)
haul_l2: G ; D, !!_E A |- C
  <- G ; D, A |- C
  <- !eq E 0
  @pretty "!!0"
  @invertible false.

% Unit·sub (the monad_r dual): what is here is reachable within ANY
% budget — operational costs are the LEAST derivable grades.
haul_r: G ; D |- !!_E A
  <- G ; D |- A
  <- !le 0 E
  @pretty "!!R"
  @invertible false.

% ── @fire (THY_0018 §5): one timed firing as a first-class step ──
% Same discipline as till (TODO_0294/0296 P2): variable arity and the
% forced-join side condition live in the config-bound fire checker
% (lib/prover/timed/fire-check.js — calculus.stepCheckers via kit.js),
% checked against the program's declared rule data + the theory
% (le/lt/qsub over the additive stamp axes: delay AND dist share the ⊕/⊖
% residual shape). Not enumerated in search (no principal); settle is the
% strategy, the kernel is the judge.
fire: G ; D |- C
  @pretty "@fire"
  @invertible false.

% ── stamped atoms (THY_0018 §5): retiming, as a stamp-aware axiom ──

at_l: G ; D, A@T1 |- A@T2
  <- !le T1 T2
  @side l
  @pretty "≤@"
  @invertible false.

copy: G, A ; D |- C
  <- G, A ; D, A |- C
  @pretty "Copy"
  @structural true.
