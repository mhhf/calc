% =============================================================================
% gill sequent rules — the graded fragment (TODO_0284 P2 scaffold)
% =============================================================================
%
% till.rules verbatim (see its header for the full design notes): gill's
% surface IS till's graded surface, so the backward judgment carries over
% unchanged — the multiplicative core, `with`, the ω and counted bang, the
% graded monad (bind via the ⊖ residual theory premise), stamped-atom
% retiming. Theory premises resolve over gill's numeric prelude
% (prelude/num.gill — till's tower + the collapsed min/max instances).
% Divergence begins at P3 (haul/`!!_d` rules), not here.

@formulas A, B, C

id: ; A |- A
  @pretty "Id"
  @invertible true.

tensor_r: G ; D, D' |- A * B
  <- G ; D |- A
  <- G ; D' |- B
  @pretty "⊗R".

tensor_l: G ; D, A * B |- C
  <- G ; D, A, B |- C
  @pretty "⊗L".

loli_r: G ; D |- A -o B
  <- G ; D, A |- B
  @pretty "⊸R".

loli_l: G ; D, D', A -o B |- C
  <- G ; D |- A
  <- G ; D', B |- C
  @pretty "⊸L".

with_r: G ; D |- A & B
  <- G ; D |- A
  <- G ; D |- B
  @pretty "&R".

with_l1: G ; D, A & B |- C
  <- G ; D, A |- C
  @pretty "&L₁".

with_l2: G ; D, A & B |- C
  <- G ; D, B |- C
  @pretty "&L₂".

one_r: G ; |- I
  @pretty "1R".

one_l: G ; D, I |- C
  <- G ; D |- C
  @pretty "1L".

% ── ω exponential (template-matched: `!A` = bang(ω, A) is the pattern) ──

bang_r: G ; |- !A
  <- G ; |- A
  @pretty "!R"
  @invertible false
  @template true
  @bridge linear_to_cartesian.

bang_l: G ; D, !A |- C
  <- G ; D, A |- C
  @pretty "!D"
  @invertible false
  @template true.

bang_l2: G ; D, !A |- C
  <- G, A ; D |- C
  @pretty "!L"
  @invertible false
  @template true
  @bridge linear_to_cartesian.

% ── counted exponential: !_k A as k linear parcels ──

bang_l3: G ; D, !_K A |- C
  <- G ; D, A, !_J A |- C
  <- !qsub K 1 J
  @pretty "!Lpeel"
  @invertible false.

bang_l4: G ; D, !_K A |- C
  <- G ; D |- C
  <- !eq K 0
  @pretty "!L0"
  @invertible false.

bang_r2: G ; D, D' |- !_K A
  <- G ; D |- A
  <- G ; D' |- !_J A
  <- !qsub K 1 J
  @pretty "!Rpeel"
  @invertible false.

bang_r3: G ; D |- !_K A
  <- !eq K 0
  @pretty "!R0"
  @invertible false.

% ── graded lax monad: bind + unit·sub (THY_0018 §4; see till.rules) ──

monad_l: G ; D, {A}@E |- {C}@F
  <- G ; D, A |- {C}@H
  <- !qsub F E H
  @side l
  @pretty "{}L"
  @invertible false.

monad_r: G ; D |- {A}@E
  <- G ; D |- A
  <- !le 0 E
  @pretty "{}R"
  @invertible false.

monad_r2: G ; D |- {A}@E
  @pretty "{}settle"
  @invertible false
  @modeShift true.

% ── stamped atoms (THY_0018 §5): retiming, as a stamp-aware axiom ──

at_l: G ; D, A@T1 |- A@T2
  <- !le T1 T2
  @side l
  @pretty "≤@"
  @invertible false.

copy: G, A ; D |- C
  <- G, A ; D, A |- C
  @pretty "Copy"
  @structural true.
