% =============================================================================
% gill — Graded Intuitionistic Linear Logic (TODO_0284)
% =============================================================================
%
% The laboratory where a grade algebra is DATA (grade-algebra.md): one
% engine, many grade instances. gill's surface is till's graded surface —
% the graded lax monad `{B}@d`, the graded exponential `!_g A`, stamps,
% windows, weighted choice — deliberately verbatim (shared Store tags, one
% numeric prelude), so a gill program is scheduled by whichever grade
% algebra the config plugs in. till stays FROZEN as the time instance; new
% grade sorts (dist here; the P3b weight prelude) and their algebras land
% in gill, and 0292's `will` extends gill.
%
% New over till: the `dist` grade sort — the (min,+) transport-cost grade
% (P3: distGrades + the `haul` comonad `!!_d A`; this declaration is the P2
% scaffold). Same additive-accumulation shape as delay, read as distance;
% single-axis per run (D1 — a run is scheduled by time OR distance).

@family gill.

formula: type.
grade: type.

% Grade SORTS (TODO_0011 rung 1): refinements of the one grade surface.
% The grammar folds these onto the single auxiliary GRADE chain; the sort
% CHECKER keeps them distinct. The prelude relates them to the numeric
% tower (delay <: q etc. — prelude/num.gill via till's rat.ill).
%
% `grade` is a CLASSIFIER grouping INDEPENDENT algebras — delay (ℚ≥0,
% additive), count (ℕ, structural peeling), weight ([0,1], static
% annotation), dist (ℚ≥0, additive transport cost). These are NOT one
% unified semiring; mixing subsorts across connectives is a type error.
delay <: grade.
count <: grade.
weight <: grade.
dist <: grade.

% Grade constants (D2/D4 markers): !_0 compile-time, ! = ω persistent.
g0: count.
gw: count.

tensor: formula -> formula -> formula
  @ascii "_ * _"
  @prec 60 left
  @category multiplicative
  @polarity positive.

loli: formula -> formula -> formula
  @ascii "_ -o _"
  @prec 50 right
  @category multiplicative
  @polarity negative.

one: formula
  @ascii "I"
  @category multiplicative
  @polarity positive.

% Graded lax monad: {B} = monad(unit, B) (grade 0); {B}@d replaces the grade.
monad: delay -> formula -> formula
  @ascii "{ #2 }"
  @category monad
  @polarity negative.

% Graded exponential: ! = ω (persistent), !_0 (compile-time), !_k / !_W
% (counted linear parcels, D4).
bang: count -> formula -> formula
  @ascii "! #2"
  @prec 80
  @category exponential.

% External choice: the ENVIRONMENT's connective (inert menus, host-collapsed).
with: formula -> formula -> formula
  @ascii "_ & _"
  @prec 70 left
  @category additive
  @polarity negative.

% Weighted internal choice: `A +[Q] B` in consequents.
woplus: weight -> formula -> formula -> formula
  @ascii "#2 +[#1] #3"
  @prec 65 left
  @category additive
  @polarity positive.

% Graded transport comonad (TODO_0284 P3): `!!_d A` — "A reachable within
% haul-cost d". The spatial dual of the delay monad (0270): {A}@d =
% achievable WITHIN duration d, !!_d A = reachable WITHIN cost budget d —
% both upper-bound readings, both exactly accounted by the ⊖ residual
% (gill.rules). Own category, NOT exponential: the graded-prefix surface
% and the exponential role (counted parcels) belong to bang; haul's grade
% argument is dist, which routes it to distGrades in the by-sort registry
% (calculus-config.js gradeAlgebraFor). Surface is a declared sorted
% template (TODO_0268 §5c — the one grammar mechanism).
haul: dist -> formula -> formula
  @ascii "!!_#1 #2"
  @prec 80
  @category comonad
  @polarity positive.

% ── Timed surface (sorted templates over kernel wrapper tags, 0268 A) ──

% Availability stamp `A@t` (E1).
at: formula -> delay -> formula
  @ascii "#1@#2"
  @prec 90 left.

% Scheduling windows (D8): activation lower bound / validity deadline.
after: delay -> formula
  @ascii "after #1".

before: delay -> formula
  @ascii "before #1".

% Read marker (E7.2): reserve without consuming.
readPreserved: formula -> formula
  @ascii "read #1".

atom: string -> formula
  @ascii "_"
  @prec 100.
