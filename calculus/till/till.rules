% =============================================================================
% till sequent rules — the graded fragment (TODO_0265 Phase 6b Stage 1)
% =============================================================================
%
% Backward provability for till's connectives. The multiplicative core and
% `with` are ill.rules verbatim. The graded parts:
%
%   ω bang      — ILL's promotion/dereliction/absorption, @template-matched:
%                 the ω grade in `!A` is part of the pattern, so these rules
%                 never fire on a counted !_k A (ill.rules' index path is
%                 grade-blind; recorded residue, rides the 0157 merge-back).
%   counted bang — !_k A ≡ A ⊗ … ⊗ A (k copies), SELL/BLL reading of D4
%                 parcels: left peel/weaken, right peel/zero. Grade
%                 side conditions (@grade) evaluate through the SAME
%                 tillGrades record the timed scheduler reads (D13).
%   graded monad — monad_l is the graded bind (delay composition d+e as a
%                 monus on the conclusion grade), monad_r the unit at
%                 grade 0. The graded-μ {{A}@d}@e ⊢ {A}@(d+e) is derivable;
%                 accounting is EXACT — availability monotonicity
%                 (subeffecting) is Stage 2 / THY-B territory, not v1.
%
% Ground grades only (matches the possessed-rule fence): a non-numeric
% grade fails every @grade side condition, so !_W/metavar-graded formulas
% are simply not provable — an honest v1 fence, not an error.
% g0-graded formulas have NO rules here: grade 0 is the compile-time label
% (composed away before runtime, THY_0015) — count zero is binlit 0.
% woplus has no sequent rules in Stage 1: the weight needs a probabilistic
% judgment (Stage 2 / THY-A), and a weight-dropping oplus reading would be
% dishonest. Declarative surface only — settle is its semantics.

@formulas A, B, C

id: ; A |- A
  @pretty "Id"
  @invertible true.

tensor_r: G ; D, D' |- A * B
  <- G ; D |- A
  <- G ; D' |- B
  @pretty "⊗R".

tensor_l: G ; D, A * B |- C
  <- G ; D, A, B |- C
  @pretty "⊗L".

loli_r: G ; D |- A -o B
  <- G ; D, A |- B
  @pretty "⊸R".

loli_l: G ; D, D', A -o B |- C
  <- G ; D |- A
  <- G ; D', B |- C
  @pretty "⊸L".

with_r: G ; D |- A & B
  <- G ; D |- A
  <- G ; D |- B
  @pretty "&R".

with_l1: G ; D, A & B |- C
  <- G ; D, A |- C
  @pretty "&L₁".

with_l2: G ; D, A & B |- C
  <- G ; D, B |- C
  @pretty "&L₂".

one_r: G ; |- I
  @pretty "1R".

one_l: G ; D, I |- C
  <- G ; D |- C
  @pretty "1L".

% ── ω exponential (template-matched: `!A` = bang(ω, A) is the pattern) ──

bang_r: G ; |- !A
  <- G ; |- A
  @pretty "!R"
  @invertible false
  @template true
  @bridge linear_to_cartesian.

bang_l: G ; D, !A |- C
  <- G ; D, A |- C
  @pretty "!D"
  @invertible false
  @template true.

bang_l2: G ; D, !A |- C
  <- G, A ; D |- C
  @pretty "!L"
  @invertible false
  @template true
  @bridge linear_to_cartesian.

% ── counted exponential: !_k A as k linear parcels ──

bang_l3: G ; D, !_K A |- C
  <- G ; D, A, !_J A |- C
  @pretty "!Lpeel"
  @invertible false
  @grade K >= 1
  @grade J := K - 1.

bang_l4: G ; D, !_K A |- C
  <- G ; D |- C
  @pretty "!L0"
  @invertible false
  @grade K = 0.

bang_r2: G ; D, D' |- !_K A
  <- G ; D |- A
  <- G ; D' |- !_J A
  @pretty "!Rpeel"
  @invertible false
  @grade K >= 1
  @grade J := K - 1.

bang_r3: G ; D |- !_K A
  @pretty "!R0"
  @invertible false
  @grade K = 0.

% ── graded lax monad (THY_0018 §4): bind + unit·sub ──
% The delay grade is an UPPER BOUND ("achievable within E" — the lax@d
% judgment); monad_r fuses lax + sub + {}R: what is true now is achievable
% within ANY bound (subeffecting — Theorem 1 needs it: operational stamps
% are the LEAST derivable grades). monad_l is {}L: binds compose delays,
% and the monus keeps the critical path a strict LOWER bound ({A}@4 from
% {{A}@2}@3 stays refuted). monad_l's side condition F >= E (equivalently
% H >= 0) is IMPLICIT in the monus — `-` fails on a negative result,
% making the rule inapplicable (THY_0018 §4 implementation-encoding note).
% The E >= 0 guard's content on non-numeric
% grades is the ground fence (ω/metavar grades fail isStamp).

monad_l: G ; D, {A}@E |- {C}@F
  <- G ; D, A |- {C}@H
  @side l
  @pretty "{}L"
  @invertible false
  @grade H := F - E.

monad_r: G ; D |- {A}@E
  <- G ; D |- A
  @pretty "{}R"
  @invertible false
  @grade E >= 0.

% The settle bridge (Stage 2, D6): {S}@T with T read as the observation
% horizon — settle(Δ, T) then exact rightFocus of S against the residual
% timed multiset (each firing = one @fire instance, THY_0018 §5). Tried
% after the backward unit; inapplicable without an engineCalc.
monad_r2: G ; D |- {A}@E
  @pretty "{}settle"
  @invertible false
  @modeShift true.

% ── stamped atoms (THY_0018 §5): retiming, as a stamp-aware axiom ──
% A@t ⊢ A@t' for t ≤ t' — delaying availability is free; never early.
% Zero premises: a template axiom (consumes only its principal).
at_l: G ; D, A@T1 |- A@T2
  @side l
  @pretty "≤@"
  @invertible false
  @grade T1 <= T2.

copy: G, A ; D |- C
  <- G, A ; D, A |- C
  @pretty "Copy"
  @structural true.
