#import(../../ill/programs/bin.ill)
#import(sorts.till)

% Exact non-negative rationals over bin — TODO_0265 Phase 1 (D3/D8.1/D14).
%
% Two representations of ONE object (the rationals, restricted to Q>=0):
%   rat(N, D)  — constructor term over bin; what these clauses match (semantics)
%   ratlit     — compact kernel leaf (num, den bigints); storage + FFI fast path
% bridged by ratlitTheory (lib/engine/theories/ratlit-theory.js), the exact
% analogue of i/o/e <-> binlit via binlitTheory.
%
% Canonical form: gcd-reduced, den > 0, den = 1 collapses to bin (Q contains N,
% one hash per value). Clauses assume canonicalized goals — the same engine
% invariant binlit clauses rely on — but derive canonical results themselves
% via qnorm, so FFI-off resolution agrees with the FFI hash-for-hash.
%
% ONE NAME PER OPERATION (TODO_0011 §3 — supersedes D8.1's split
% namespaces): plus/mul/lt/le/eq/neq/eq_bool are shared across the numeric
% tower — bin.ill's clauses are the bin instance, the /q clauses below the
% instance at the bound q. Dispatch is first-order matching (bin clauses
% pattern on digits, /q coerces), the checker solves the bounded sort
% variable per goal, and the FFI face mirrors it (num.* handlers). The
% COHERENCE law decides what may share: the shared set agrees on the bin
% overlap (n ↦ n/1 embeds homomorphically); qsub (checked, not monus) and
% qdiv (field, not Euclidean) DISAGREE there, so they keep their own names
% — the Integral/Fractional cut. The /q clause HEADS pattern on a rat(_,_)
% argument (two variants, first/second position), so pure-bin goals can
% NEVER enter them — dispatch is order-independent under the engine's
% committed-choice resolution, and the numerator recursion inside a /q
% body reaches only the bin instance. Mixed-goal legality for the CHECKER
% is the declared instance signature at the bound (the second `op: q…`
% line per operation).

% ── The numeric tower (TODO_0011 rung 1) ──
% q is THE numeric sort (non-negative rationals, v1); bin (the naturals,
% constructed by e/i/o in bin.ill) embeds by subsumption — the static face
% of the binlit↔rat n ↦ n/1 eq-theory coercion. frac is the explicit-
% fraction representation (the rat constructor); canonical form keeps the
% integer fragment entirely inside bin (den = 1 collapses), so bin and
% frac are disjoint SIBLINGS below q. The grade sorts declared in
% till.calc (delay/count/weight) join the tower here: durations and counts
% are rationals (window arithmetic feeds them to q-ops), naturals are
% valid durations and counts. Weights ([0,1]) admit literals only through
% the value fence — no bin <: weight, or 5 would be a weight statically.
q: type.
frac: type.
bin <: q.
frac <: q.
delay <: q.
count <: q.
weight <: q.
bin <: delay.
bin <: count.

rat: (num: bin) -> (den: bin) -> frac.

% === Internals ===

% gcd A B G — Euclid; gcd(X, 0) = X. B strictly decreases: terminating.
% Clause-produced bins can carry leading-zero padding (e.g. sub 2 2 = (o e),
% value 0 — see the trim notes in bin.ill), so the recursion guards by VALUE
% (gt, which walks padded zeros correctly) and trims the remainder before
% recursing, keeping the structural e-match in gcd/z reachable.
gcd: (a: bin) -> (b: bin) -> (g: bin) -> type.
gcd/z: gcd X e X.
gcd/s: gcd X Y G
  <- gt Y e e (i e)
  <- mod X Y R
  <- trim R R'
  <- gcd Y R' G.

% qnorm N D R — R is N/D in canonical form: gcd-reduced, den = 1 collapses
% to the bare bin numerator. Guarded on D > 0 (a zero denominator FAILS —
% this is how qdiv rejects division by zero).
qnorm: (num: bin) -> (den: bin) -> (r: q) -> type.
% den = 1 shortcut: N/1 is already canonical — skips Euclid entirely, which
% matters in clause mode where div/mod resolve via repeated subtraction
% (depth linear in the quotient). Overlaps qnorm/z on den = 1; both derive
% the same R (confluent).
qnorm/one: qnorm N (i e) N.
% One derivation: reduce once, then pack by the residual denominator —
% the earlier int/frac clause pair re-derived gcd + div on backtracking
% (round-14.5: the heavy prefix now runs exactly once).
qnorm/z: qnorm N D R
  <- neq D e
  <- gcd N D G
  <- div D G D'
  <- div N G N'
  <- qpack N' D' R.

% qpack N D R — attach the canonical denominator: 1 collapses to the bin.
qpack: (num: bin) -> (den: bin) -> (r: q) -> type.
qpack/int: qpack N (i e) N.
qpack/frac: qpack N D (rat N D)
  <- neq D (i e).

% to_q X Q — coerce bin or rat to rat form (n |-> n/1).
to_q: (x: q) -> (r: frac) -> type.
to_q/q: to_q (rat N D) (rat N D).
to_q/e: to_q e (rat e (i e)).
to_q/o: to_q (o X) (rat (o X) (i e)).
to_q/i: to_q (i X) (rat (i X) (i e)).

% === The shared numeric operations (TODO_0011 SS3 - the dispatch rider) ===
% plus/mul/lt/le/eq/neq/eq_bool are ONE predicate each across the tower.
% The bounded-variable signatures below PROMOTE bin.ill's concrete
% signatures to declared instances (loader, TODO_0011 SSinstances); the /q
% clauses are the instance AT THE BOUND - bare-variable heads, so mixed
% bin/frac goals are legal precisely because they exist (strictness =
% instance absence). Dispatch is first-order matching: bin clauses pattern
% on i/o/e digits and fail structurally on fractions; the /q clauses coerce
% (to_q: n |-> n/1) and cross-multiply. Their recursive premises use the
% shared names too - numerator arithmetic dispatches back to the bin
% instance per-goal (cross-instance recursion). The FFI face mirrors this
% (num.* handlers: bin fast path, rational fallback); results go through
% qnorm/putRat so both paths agree hash-for-hash (FFI principle).
%
% qsub and qdiv are NOT collapsed: bin sub is a saturating monus and bin
% div is Euclidean, while qsub is CHECKED (fails on negative - a
% saturating rational monus fed into repeated-subtraction loops derives
% wrong quotients) and qdiv is exact field division. They disagree with
% the bin operations on the shared subsort, so the coherence law forbids
% sharing a name - the Integral/Fractional cut.

plus: (s <: q) (a: s) -> (b: s) -> (r: s) -> type.
plus: (a: q) -> (b: q) -> (r: q) -> type.
plus/qf: plus (rat A B) V R
  <- to_q V (rat C D)
  <- mul A D X
  <- mul C B Y
  <- plus X Y N
  <- mul B D M
  <- qnorm N M R.
plus/qb: plus U (rat C D) R
  <- to_q U (rat A B)
  <- mul A D X
  <- mul C B Y
  <- plus X Y N
  <- mul B D M
  <- qnorm N M R.

mul: (s <: q) (a: s) -> (b: s) -> (r: s) -> type.
mul: (a: q) -> (b: q) -> (r: q) -> type.
mul/qf: mul (rat A B) V R
  <- to_q V (rat C D)
  <- mul A C N
  <- mul B D M
  <- qnorm N M R.
mul/qb: mul U (rat C D) R
  <- to_q U (rat A B)
  <- mul A C N
  <- mul B D M
  <- qnorm N M R.

lt: (s <: q) (a: s) -> (b: s) -> type.
lt: (a: q) -> (b: q) -> type.
lt/qf: lt (rat A B) V
  <- to_q V (rat C D)
  <- mul A D X
  <- mul C B Y
  <- lt X Y.
lt/qb: lt U (rat C D)
  <- to_q U (rat A B)
  <- mul A D X
  <- mul C B Y
  <- lt X Y.

le: (s <: q) (a: s) -> (b: s) -> type.
le: (a: q) -> (b: q) -> type.
le/qf: le (rat A B) V
  <- to_q V (rat C D)
  <- mul A D X
  <- mul C B Y
  <- le X Y.
le/qb: le U (rat C D)
  <- to_q U (rat A B)
  <- mul A D X
  <- mul C B Y
  <- le X Y.

eq: (s <: q) (a: s) -> (b: s) -> type.
eq: (a: q) -> (b: q) -> type.
eq/qf: eq (rat A B) V
  <- to_q V (rat C D)
  <- mul A D X
  <- mul C B Y
  <- eq X Y.
eq/qb: eq U (rat C D)
  <- to_q U (rat A B)
  <- mul A D X
  <- mul C B Y
  <- eq X Y.

neq: (s <: q) (a: s) -> (b: s) -> type.
neq: (a: q) -> (b: q) -> type.
neq/qf: neq (rat A B) V
  <- to_q V (rat C D)
  <- mul A D X
  <- mul C B Y
  <- neq X Y.
neq/qb: neq U (rat C D)
  <- to_q U (rat A B)
  <- mul A D X
  <- mul C B Y
  <- neq X Y.

% eq_bool's /q clauses keep bare heads: their premises go to eq/neq (which
% dispatch structurally), never back to eq_bool — no regress is possible,
% and the bare heads ARE the instance at the bound.
eq_bool: (s <: q) (a: s) -> (b: s) -> (r: bin) -> type.
eq_bool/qt: eq_bool U V (i e) <- eq U V.
eq_bool/qf: eq_bool U V e <- neq U V.

% Checked subtraction: FAILS on negative results (Q>=0 - debt/dual grades
% deferred). Total on the tower (both arguments coerce).
qsub: (a: q) -> (b: q) -> (r: q) -> type.
qsub/z: qsub U V R
  <- to_q U (rat A B)
  <- to_q V (rat C D)
  <- mul A D X
  <- mul C B Y
  <- checked_sub X Y N
  <- mul B D M
  <- qnorm N M R.

% Exact (field) division; C = 0 makes the qnorm den-guard fail.
qdiv: (a: q) -> (b: q) -> (r: q) -> type.
qdiv/z: qdiv U V R
  <- to_q U (rat A B)
  <- to_q V (rat C D)
  <- mul A D N
  <- mul B C M
  <- qnorm N M R.
