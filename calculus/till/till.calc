% =============================================================================
% till — Timed Intuitionistic Linear Logic (TODO_0265, D2/D6/D10)
% =============================================================================
%
% ILL's multiplicative core plus the GRADED lax monad `{B}@d` (duration as an
% effect grade, E2) and the graded exponential `!_g A` (count parcels, D4).
% Availability stamps `A@t` (E1), windows `after E` / `before E` (D8), and
% the `read` marker (E7.2) are timedAnnotations grammar forms over kernel
% tags (at/after/before/readPreserved) — not connectives, so they are not
% declared here.
%
% tensor/loli/one/bang reuse ILL's store tags deliberately (shared Store);
% gmonad is till's OWN 2-ary monad tag — ILL's unary `{A}` is untouched (D6).
% Additives: internal choice is the weighted `woplus` (Phase 4b); external
% choice is `with` (Phase 6 — inert menus collapsed by choose()); oplus/zero
% stay absent.

@family till.

formula: type.
grade: type.

tensor: formula -> formula -> formula
  @ascii "_ * _"
  @prec 60 left
  @category multiplicative
  @polarity positive.

loli: formula -> formula -> formula
  @ascii "_ -o _"
  @prec 50 right
  @category multiplicative
  @polarity negative.

one: formula
  @ascii "I"
  @category multiplicative
  @polarity positive.

% Graded lax monad: {B} = gmonad(unit, B) (delay 0); {B}@d replaces the grade.
gmonad: grade -> formula -> formula
  @ascii "{ #2 }"
  @category monad
  @polarity negative.

% Graded exponential: ! = ω (persistent), !_0 (compile-time), !_k / !_W
% (counted linear parcels, D4 — timed-matcher-only).
bang: grade -> formula -> formula
  @ascii "! #2"
  @prec 80
  @category exponential.

% External choice (Phase 6): the ENVIRONMENT's connective. A forward rule
% OFFERS `A & B` as ONE inert linear fact — settle never collapses it (that
% is what makes a menu a renderable decision surface); the host collapses
% it via choose() (with-projection), and only among offered alternatives.
% Decisions are projections of offered choices, never fabricated tokens.
with: formula -> formula -> formula
  @ascii "_ & _"
  @prec 70 left
  @category additive
  @polarity negative.

% Weighted internal choice (Phase 4b): `woplus Q A B` in consequents —
% branch A with probability Q, B with 1−Q (Q a ground rational in [0,1]).
% Prefix form parses via application (no @ascii operator — a ternary infix
% doesn't fit the binary-operator grammar; sugar can come later). exec
% samples by weight through the D17 PRF; explore expands both branches
% with the weight on the edge — the tree is the exact distribution.
woplus: grade -> formula -> formula -> formula
  @category additive
  @polarity positive.

atom: string -> formula
  @ascii "_"
  @prec 100.
