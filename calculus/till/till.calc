% =============================================================================
% till — Timed Intuitionistic Linear Logic (TODO_0265, D2/D6/D10)
% =============================================================================
%
% ILL's multiplicative core plus the GRADED lax monad `{B}@d` (duration as an
% effect grade, E2) and the graded exponential `!_g A` (count parcels, D4).
% Availability stamps `A@t` (E1), windows `after E` / `before E` (D8), and
% the `read` marker (E7.2) are DECLARED sorted templates over kernel tags
% (at/after/before/readPreserved) — the declaration opts into the surface
% (TODO_0268 item A); the semantics stay kernel-owned (convert desugars,
% compile strips, the scheduler fires), like $/preserved.
%
% tensor/loli/one/bang/monad reuse ILL's store tags deliberately (shared
% Store) — the monad is the ONE binary graded node since the D6 merge-back
% (TODO_0157); ILL's `{A}` is its trivial-grade (delay-0) instance.
% Additives: internal choice is the weighted `woplus` (Phase 4b); external
% choice is `with` (Phase 6 — inert menus collapsed by choose()); oplus/zero
% stay absent.

@family till.

formula: type.
grade: type.

% Grade SORTS (TODO_0011 rung 1): refinements of the one grade surface.
% The grammar folds these onto the single auxiliary GRADE chain (numerals
% lex exactly — D3); the sort CHECKER keeps them distinct — durations on
% the monad, counts on the bang, weights on woplus. The prelude relates
% them to the numeric tower (count <: q etc. in rat.ill) for arithmetic.
%
% IMPORTANT: `grade` is a CLASSIFIER grouping THREE INDEPENDENT algebras —
%   delay  (ℚ≥0, additive: monad delays compose by addition)
%   count  (ℕ, structural peeling: bang parcels consumed one-by-one)
%   weight ([0,1], static annotation: woplus branch probability)
% These are NOT one unified semiring. Mixing subsorts across connectives
% (e.g. a count grade on the monad) is a type error.
delay <: grade.
count <: grade.
weight <: grade.

% Grade constants (D2/D4 markers, atoms minted by lib/engine/grades.js):
% !_0 compile-time, ! = ω persistent. Members of count — no @ascii, so
% they add nothing to the grammar (the !-suffix forms are parser-owned).
g0: count.
gw: count.

tensor: formula -> formula -> formula
  @ascii "_ * _"
  @prec 60 left
  @category multiplicative
  @polarity positive.

loli: formula -> formula -> formula
  @ascii "_ -o _"
  @prec 50 right
  @category multiplicative
  @polarity negative.

one: formula
  @ascii "I"
  @category multiplicative
  @polarity positive.

% Graded lax monad: {B} = monad(unit, B) (delay 0); {B}@d replaces the grade.
monad: delay -> formula -> formula
  @ascii "{ #2 }"
  @category monad
  @polarity negative.

% Graded exponential: ! = ω (persistent), !_0 (compile-time), !_k / !_W
% (counted linear parcels, D4 — timed-matcher-only).
bang: count -> formula -> formula
  @ascii "! #2"
  @prec 80
  @category exponential.

% External choice (Phase 6): the ENVIRONMENT's connective. A forward rule
% OFFERS `A & B` as ONE inert linear fact — settle never collapses it (that
% is what makes a menu a renderable decision surface); the host collapses
% it via choose() (with-projection), and only among offered alternatives.
% Decisions are projections of offered choices, never fabricated tokens.
with: formula -> formula -> formula
  @ascii "_ & _"
  @prec 70 left
  @category additive
  @polarity negative.

% Weighted internal choice (Phase 4b): `A +[Q] B` in consequents —
% branch A with probability Q, B with 1−Q (Q a ground rational in [0,1]).
% The mixfix template is a sorted infix (TODO_0268 item A); the prefix form
% `woplus Q A B` still parses via application. exec samples by weight
% through the D17 PRF; explore expands both branches with the weight on
% the edge — the tree is the exact distribution.
woplus: weight -> formula -> formula -> formula
  @ascii "#2 +[#1] #3"
  @prec 65 left
  @category additive
  @polarity positive.

% ── Timed surface (sorted templates over kernel wrapper tags, 0268 A) ──

% Availability stamp `A@t` (E1). Postfix (left-edge same-sort hole); binds
% tighter than every operator. The `@` pun on graded computations
% (`{B}@d` regrades the monad) is kernel-owned (parser atAction).
at: formula -> delay -> formula
  @ascii "#1@#2"
  @prec 90 left.

% Scheduling windows (D8): activation lower bound / validity deadline.
% Closed forms (grade hole only) — ATOM-level keyword productions.
after: delay -> formula
  @ascii "after #1".

before: delay -> formula
  @ascii "before #1".

% Read marker (E7.2, test arc): reserve without consuming.
readPreserved: formula -> formula
  @ascii "read #1".

atom: string -> formula
  @ascii "_"
  @prec 100.
