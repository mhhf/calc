% =============================================================================
% fill sequent rules — μMALL fixed points (TODO_0009 rung 3, Baelde 2012)
% =============================================================================
%
% fill's backward judgment = ill.rules (loaded FIRST — calculus.load takes a
% rules-file list; ILL's fragment is inherited BY REFERENCE, never copied)
% plus the fill-OWN fixpoint unfold rules below. .rules files have no @extends
% mechanism, so the list [ill.rules, fill.rules] is assembled in fill's
% calculus-config / loader.
% =============================================================================

@formulas A, B, C

% Fixed points (μMALL, TODO_0009 rung 3). The four unfold rules realize the
% fixed-point identity σX.F = F[σX.F/X] (Knaster–Tarski). @binding unfold opens
% the de-Bruijn body with the WHOLE principal formula (μX.F / νX.F) as the
% witness — a single deterministic substitution the kernel re-derives exactly
% (no fresh variable, hence fully verified, unlike ∃/∀). Polarity from fill.calc:
% μ positive → μL invertible, μR needs focus (@invertible false); ν negative →
% νR invertible, νL needs focus (@invertible false).
mu_r: G ; D |- mu A
  <- G ; D |- A
  @pretty "μR"
  @invertible false
  @binding unfold.

mu_l: G ; D, mu A |- C
  <- G ; D, A |- C
  @pretty "μL"
  @binding unfold.

nu_r: G ; D |- nu A
  <- G ; D |- A
  @pretty "νR"
  @binding unfold.

nu_l: G ; D, nu A |- C
  <- G ; D, A |- C
  @pretty "νL"
  @invertible false
  @binding unfold.
